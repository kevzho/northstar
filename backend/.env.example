# Copy to backend/.env and fill in. Real process environment wins over this
# file, so a hosted deployment ignores it entirely.

# --- Supabase (required) -----------------------------------------------
# Project Settings -> API
SUPABASE_URL=https://<project>.supabase.co

# The service_role key. It BYPASSES row-level security, which is the whole
# reason the browser never talks to Postgres directly. It belongs here and
# in the backend host's dashboard, and nowhere else.
SUPABASE_SECRET_KEY=<service-role key>

# Project Settings -> API -> JWT Settings. Used to verify the bearer token
# the frontend sends; without it every authenticated route rejects.
SUPABASE_JWT_SECRET=<JWT secret>

# Must match the origin the browser loads from, or CORS blocks every call.
FRONTEND_URL=http://localhost:3000

# --- Language model (optional) -----------------------------------------
# Leave unset and the app still runs: /advisor returns 503, no profile
# embeddings are written, and the plan falls back to its authored spines.
# /health reports "unconfigured" for both rather than pretending.
#
# NVIDIA NIM has a free tier and is OpenAI-compatible; any compatible
# provider works.
LLM_API_BASE=https://integrate.api.nvidia.com/v1
LLM_API_KEY=
LLM_MODEL=nvidia/nemotron-3.5-bolt-e4b
