# ---- Frontend (public, exposed to the browser) ----
# Base URL of the FastAPI backend. REQUIRED: frontend/lib/api.ts falls back to
# "" when this is unset, which turns every API call into a same-origin request
# against the Next.js server (/match, /mentors, ...) and 404s the whole app.
# Local dev: http://localhost:8000 — production: the deployed backend on Vercel
# (e.g. https://northstar-api-theta.vercel.app).
NEXT_PUBLIC_API_URL=http://localhost:8000

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---- Backend (server-only, never prefixed with NEXT_PUBLIC_) ----
# Read by backend/app/settings.py from backend/.env or the process env.
# Do not expose them to the client.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_JWT_SECRET=

# Frontend URL the backend allows via CORS (defaults to http://localhost:3000).
FRONTEND_URL=http://localhost:3000
