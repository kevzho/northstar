# Copy to frontend/.env.local.
#
# Everything here is shipped to the browser. NEXT_PUBLIC_ is not a wrapper
# that keeps a value safe, it is the opposite: it marks a value as public.
# Backend secrets live in backend/.env.example and must never appear here.

# The FastAPI origin. Required: without it lib/api.ts falls back to "" and
# every call is issued against the Next.js server instead of the API, which
# fails as a 404 on a route that looks like it should exist.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co

# The anon/publishable key. Safe to ship: row-level security denies it
# everything, which is why the browser never queries a table directly.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<anon key>
